ELASTICSEARCH_URL=http://localhost:9200
# For Elasticsearch Cloud, set an HTTPS URL and API key.
ELASTICSEARCH_API_KEY=
# Optional Dash0 export; endpoint is the OTLP base URL, without /v1/traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
DASH0_AUTH_TOKEN=
OTEL_SERVICE_NAME=find-the-right-talk
# Optional local AI (keyword search works without Ollama).
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_EMBED_MODEL=embeddinggemma
OLLAMA_CHAT_MODEL=qwen2.5:1.5b

# Choose ollama (local default) or elastic (Elastic Cloud semantic_text / EIS).
ELASTICSEARCH_SEMANTIC_PROVIDER=ollama
ELASTICSEARCH_INFERENCE_ID=.jina-embeddings-v5-text-small

# Optional OpenAI intent extraction; browser requests must also opt in.
OPENAI_SMART_SEARCH_ENABLED=false
OPENAI_API_KEY=
OPENAI_QUERY_MODEL=gpt-4.1-mini
